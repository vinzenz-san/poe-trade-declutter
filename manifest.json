{
  "manifest_version": 3,
  "name": "PoE Trade Declutter",
  "version": "0.3.0",
  "description": "Hide unwanted filter categories/filters and pick minimum stat tiers on the Path of Exile trade site — reversible with one click.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.pathofexile.com/trade/*"],
      "js": ["dist/content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "scripts": ["dist/background.js"]
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon-32.png"],
      "matches": ["https://www.pathofexile.com/*"]
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://raw.githubusercontent.com/brather1ng/RePoE/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "poe-trade-declutter@vinzenz-dev.de",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
